{
  "name": "tauri-file-transfer",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform local network file transfer app built with Tauri.",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "npm run android:phone",
    "android:build:apk": "tauri android build --apk --target aarch64",
    "android:sign:apk": "node scripts/sign-android-apk.mjs",
    "android:release:apk": "npm run android:build:apk && npm run android:sign:apk",
    "frontend:dev": "vite",
    "frontend:build": "vite build",
    "android:hot": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk --target aarch64",
    "android:install:debug": "node scripts/android-install-debug.mjs",
    "android:phone": "npm run android:build:debug && npm run android:install:debug"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
