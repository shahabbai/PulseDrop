{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseDrop",
  "version": "0.1.0",
  "identifier": "com.pulsedrop.transfer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run frontend:build",
    "beforeBuildCommand": "npm run frontend:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PulseDrop",
        "width": 1120,
        "height": 760,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://*:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local file transfer",
    "longDescription": "Transfer files between devices on the same local network.",
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
